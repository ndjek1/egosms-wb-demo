# Copy to .env and provide real values. The application reads this file automatically.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_REGISTRATION_PIN=
META_TOKEN_ENCRYPTION_KEY=

# Server-side Gemini assistant. Create this key in Google AI Studio and never expose it in XHTML or browser JavaScript.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: number of recent WhatsApp messages included in each AI request (4-40).
GEMINI_CONVERSATION_HISTORY_LIMIT=20
