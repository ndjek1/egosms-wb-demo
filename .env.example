# Copy to .env and provide real values. The application reads this file automatically.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_API_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
META_REGISTRATION_PIN=
META_TOKEN_ENCRYPTION_KEY=

# egoSms service-fee billing. Meta continues to bill each client WABA directly.
# Keep disabled until the client-facing service rate has been approved.
EGOSMS_SERVICE_FEE_BILLING_ENABLED=false
EGOSMS_SERVICE_FEE_CURRENCY=UGX
EGOSMS_MONTHLY_SUBSCRIPTION_FEE=0
